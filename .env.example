# OAuth 2.0 Client ID from Google Cloud Console (Web application type)
GOOGLE_CLIENT_ID=

# OAuth 2.0 Client Secret from Google Cloud Console
GOOGLE_CLIENT_SECRET=

# Must exactly match the redirect URI registered in Google Cloud Console
GOOGLE_OAUTH_REDIRECT_URI=https://<your-railway-domain>/oauth/callback

# Only Google accounts in this Workspace domain are allowed through
ALLOWED_GOOGLE_DOMAIN=ninjacart.com

# Signs this server's own short-lived access tokens (openssl rand -hex 32) —
# do not reuse a secret from any other project
MCP_JWT_SECRET=

# This server's own public base URL (OAuth issuer + JWT audience)
MCP_PUBLIC_URL=https://<your-railway-domain>

# Read-only connection string using the mcp_readonly role from
# packtrack-pro/db/024_mcp_readonly_role.sql
PACKTRACK_READONLY_DATABASE_URL=postgresql://mcp_readonly:password@host/dbname?sslmode=require

# Same Neon database, used for the knowledge_chunks table (pgvector) — can be the
# mcp_readonly connection if it's granted INSERT/SELECT on knowledge_chunks only,
# or a second small-scope role; decide at implementation time.
KNOWLEDGE_DATABASE_URL=postgresql://mcp_knowledge:password@host/dbname?sslmode=require

# Voyage AI API key (voyage-4 embeddings, used by search_packtrack_knowledge)
EMBEDDING_API_KEY=

# Port the server listens on (Railway sets this automatically; default 3000 locally)
PORT=3000
